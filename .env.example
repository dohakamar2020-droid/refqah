# ── Production (Vercel + Neon) ──────────────────────────────
# When DATABASE_URL is set, the app uses Neon PostgreSQL (serverless driver).
# Vercel Marketplace integration sets this automatically.
#
# ⚠️ Keep this commented out for local development. If DATABASE_URL is set to
# the placeholder below, the app will try to reach Neon instead of using the
# embedded local database and every request will fail. Uncomment and fill in
# the real connection string only when connecting to Neon.
# DATABASE_URL=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Local development (no DATABASE_URL) → embedded PGlite at PGLITE_DIR
PGLITE_DIR=./.data/pglite

# Seed script (creates the teacher account + demo data)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@refqah.local
ADMIN_PASSWORD=admin12345
SEED_DEMO_STUDENTS=true
