+"use client";
+
+import { createAuthClient } from "better-auth/react";
+import { usernameClient, inferAdditionalFields } from "better-auth/client/plugins";
+import type { auth } from "@/lib/auth";
+
+export const authClient = createAuthClient({
+  baseURL: process.env.NEXT_PUBLIC_APP_URL || undefined,
+  plugins: [usernameClient(), inferAdditionalFields<typeof auth>()],
+});
+
+export type AuthClient = typeof authClient;
diff --git a/src/lib/auth.ts b/src/lib/auth.ts
new file mode 100644
index 0000000..d3b3edc
--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,57 @@
+import { betterAuth } from "better-auth";
+import { drizzleAdapter } from "better-auth/adapters/drizzle";
+import { username } from "better-auth/plugins";
+import { db, schema } from "@/lib/db";
+
+/**
+ * Better Auth configuration.
+ * - Email + password sign-in
+ * - Username sign-in (via the username plugin) — students may use either
+ * - Role stored as an additional field on `user` ("admin" | "student")
+ */
+export const auth = betterAuth({
+  appName: "رِفقة الأربعين",
+  database: drizzleAdapter(db, {
+    provider: "pg",
+    schema: {
+      user: schema.user,
+      session: schema.session,
+      account: schema.account,
+      verification: schema.verification,
+    },
+  }),
+  baseURL: process.env.BETTER_AUTH_URL || undefined,
+  secret: process.env.BETTER_AUTH_SECRET || "refqah-dev-secret-change-in-production",
+  emailAndPassword: {
+    enabled: true,
+    autoSignIn: true,
+  },
+  session: {
+    expiresIn: 60 * 60 * 24 * 30, // 30 days
+    updateAge: 60 * 60 * 24,
+    cookieCache: { enabled: false },
+  },
+  user: {
+    additionalFields: {
+      role: {
+        type: "string",
+        required: false,
+        defaultValue: "student",
+        input: false, // never settable from the client
+      },
+    },
+  },
+  plugins: [
+    username({
+      minUsernameLength: 3,
+      maxUsernameLength: 30,
+      usernameNormalizer: (u) => u.trim().toLowerCase(),
+    }),
+  ],
+  trustedOrigins: [
+    process.env.NEXT_PUBLIC_APP_URL,
+    process.env.BETTER_AUTH_URL,
+  ].filter((o): o is string => Boolean(o)),
+});
+
+export type Session = typeof auth.$Infer.Session;
diff --git a/src/lib/db/index.ts b/src/lib/db/index.ts
new file mode 100644
index 0000000..f99200e
--- /dev/null
+++ b/src/lib/db/index.ts
@@ -0,0 +1,32 @@
+import { PGlite } from "@electric-sql/pglite";
+import { drizzle as drizzlePglite } from "drizzle-orm/pglite";
+import { drizzle as drizzleNeon } from "drizzle-orm/neon-serverless";
+import { Pool } from "@neondatabase/serverless";
+import * as schema from "./schema";
+
+export { schema };
+export * from "./schema";
+
+/**
+ * Database client.
+ *
+ * - If DATABASE_URL is set → Neon PostgreSQL (serverless driver, works on Vercel).
+ * - Otherwise → embedded PGlite (real Postgres engine in WASM) stored under
+ *   PGLITE_DIR for local development, so the exact same Drizzle/Postgres code
+ *   runs locally without any external service.
+ */
+function createDb() {
+  if (process.env.DATABASE_URL) {
+    const pool = new Pool({ connectionString: process.env.DATABASE_URL });
+    return drizzleNeon(pool, { schema });
+  }
+  const dir = process.env.PGLITE_DIR ?? "./.data/pglite";
+  const client = new PGlite(dir);
+  return drizzlePglite(client, { schema });
+}
+
+const globalForDb = globalThis as unknown as { __refqahDb?: ReturnType<typeof createDb> };
+
+export const db = (globalForDb.__refqahDb ??= createDb());
+
+export type Db = typeof db;
diff --git a/src/lib/db/schema.ts b/src/lib/db/schema.ts
new file mode 100644
index 0000000..6cbd0a6
--- /dev/null
+++ b/src/lib/db/schema.ts
@@ -0,0 +1,178 @@
+import {
+  pgTable,
+  text,
+  integer,
+  boolean,
+  timestamp,
+  uniqueIndex,
+  index,
+} from "drizzle-orm/pg-core";
+
+/* ────────────────────────────────
+ * Better Auth tables
+ * ──────────────────────────────── */
+
+export const user = pgTable("user", {
+  id: text("id").primaryKey(),
+  name: text("name").notNull(),
+  email: text("email").notNull().unique(),
+  emailVerified: boolean("email_verified").notNull().default(false),
+  image: text("image"),
+  // username plugin fields
+  username: text("username").unique(),
+  displayUsername: text("display_username"),
+  // app role: "admin" (المعلمة) | "student" (الطالبة)
+  role: text("role").notNull().default("student"),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+export const session = pgTable("session", {
+  id: text("id").primaryKey(),
+  expiresAt: timestamp("expires_at").notNull(),
+  token: text("token").notNull().unique(),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+  ipAddress: text("ip_address"),
+  userAgent: text("user_agent"),
+  userId: text("user_id")
+    .notNull()
+    .references(() => user.id, { onDelete: "cascade" }),
+});
+
+export const account = pgTable("account", {
+  id: text("id").primaryKey(),
+  accountId: text("account_id").notNull(),
+  providerId: text("provider_id").notNull(),
+  userId: text("user_id")
+    .notNull()
+    .references(() => user.id, { onDelete: "cascade" }),
+  accessToken: text("access_token"),
+  refreshToken: text("refresh_token"),
+  idToken: text("id_token"),
+  accessTokenExpiresAt: timestamp("access_token_expires_at"),
+  refreshTokenExpiresAt: timestamp("refresh_token_expires_at"),
+  scope: text("scope"),
+  password: text("password"),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+export const verification = pgTable("verification", {
+  id: text("id").primaryKey(),
+  identifier: text("identifier").notNull(),
+  value: text("value").notNull(),
+  expiresAt: timestamp("expires_at").notNull(),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+/* ────────────────────────────────
+ * App tables
+ * ──────────────────────────────── */
+
+/** Student profile — 1:1 with a user account. Privacy settings live here. */
+export const student = pgTable("student", {
+  id: text("id").primaryKey(),
+  userId: text("user_id")
+    .notNull()
+    .unique()
+    .references(() => user.id, { onDelete: "cascade" }),
+  displayName: text("display_name").notNull(),
+  avatarUrl: text("avatar_url"),
+  /** موافقة الطالبة على الظهور في لوحة أفضل 3 */
+  competitionOptIn: boolean("competition_opt_in").notNull().default(false),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+/** The 42 hadiths of the course. */
+export const hadith = pgTable("hadith", {
+  id: text("id").primaryKey(),
+  order: integer("order").notNull().unique(),
+  title: text("title").notNull(),
+  arabicText: text("arabic_text").notNull(),
+  source: text("source"),
+  published: boolean("published").notNull().default(false),
+  publishedAt: timestamp("published_at"),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+/** Recitation status of one student for one hadith (recited / not yet). */
+export const recitation = pgTable(
+  "recitation",
+  {
+    id: text("id").primaryKey(),
+    studentId: text("student_id")
+      .notNull()
+      .references(() => student.id, { onDelete: "cascade" }),
+    hadithId: text("hadith_id")
+      .notNull()
+      .references(() => hadith.id, { onDelete: "cascade" }),
+    recited: boolean("recited").notNull().default(false),
+    /** وقت اعتماد التسميع — يُستخدم لتحديد أول من أتمّت الحديث الأول */
+    recitedAt: timestamp("recited_at"),
+    updatedAt: timestamp("updated_at").notNull().defaultNow(),
+  },
+  (t) => [
+    uniqueIndex("recitation_student_hadith_uidx").on(t.studentId, t.hadithId),
+    index("recitation_hadith_idx").on(t.hadithId),
+    index("recitation_student_idx").on(t.studentId),
+  ]
+);
+
+/** Honors / badges, e.g. «سَابِقَةُ الخَيْرَات» لأول من أتمّت الحديث الأول. */
+export const achievement = pgTable("achievement", {
+  id: text("id").primaryKey(),
+  studentId: text("student_id")
+    .notNull()
+    .references(() => student.id, { onDelete: "cascade" }),
+  type: text("type").notNull(), // "first_hadith" | ...
+  hadithId: text("hadith_id").references(() => hadith.id, {
+    onDelete: "set null",
+  }),
+  title: text("title").notNull(),
+  description: text("description"),
+  awardedAt: timestamp("awarded_at").notNull().defaultNow(),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+});
+
+/** Global competition (Top 3) switch — controlled by the teacher only. */
+export const competitionSettings = pgTable("competition_settings", {
+  id: text("id").primaryKey().default("main"),
+  enabled: boolean("enabled").notNull().default(false),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
+
+/** Library of encouraging messages — original wording, rotated per visit. */
+export const message = pgTable("message", {
+  id: text("id").primaryKey(),
+  text: text("text").notNull(),
+  category: text("category"), // تحفيز | امتنان | همة | continuation | احتifa...
+  active: boolean("active").notNull().default(true),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+});
+
+/* ── Types ── */
+
+export type User = typeof user.$inferSelect;
+export type Student = typeof student.$inferSelect;
+export type Hadith = typeof hadith.$inferSelect;
+export type Recitation = typeof recitation.$inferSelect;
+export type Achievement = typeof achievement.$inferSelect;
+export type CompetitionSettings = typeof competitionSettings.$inferSelect;
+export type Message = typeof message.$inferSelect;
+
+export const schema = {
+  user,
+  session,
+  account,
+  verification,
+  student,
+  hadith,
+  recitation,
+  achievement,
+  competitionSettings,
+  message,
+};
